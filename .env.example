# Copy to .env.local and fill in your own values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecomkiji
MONGODB_DB=ecomkiji
JWT_SECRET=replace-with-a-long-random-string
SEED_SECRET=replace-with-a-secret
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Super Admin
# Optional second administrator, also created by `npm run seed`. Leave blank to
# skip. Useful for giving the site owner their own login without editing source.
SEED_ADMIN2_EMAIL=
SEED_ADMIN2_PASSWORD=
SEED_ADMIN2_NAME=Administrator
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Single public contact address: site enquiries, support, and the payment
# gateway account all use this one address. Optional — defaults to
# poorprice@yahoo.com in lib/site-config.ts.
NEXT_PUBLIC_SITE_EMAIL=poorprice@yahoo.com
# Public origin, used for absolute URLs in metadata and outbound email.
NEXT_PUBLIC_SITE_URL=https://poorprice.com
