# Copy to .env.local and fill in your own values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecomkiji
MONGODB_DB=ecomkiji
JWT_SECRET=replace-with-a-long-random-string
SEED_SECRET=replace-with-a-secret
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Super Admin
# Optional second administrator, also created by `npm run seed`. Leave blank to
# skip. Useful for giving the site owner their own login without editing source.
SEED_ADMIN2_EMAIL=
SEED_ADMIN2_PASSWORD=
SEED_ADMIN2_NAME=Administrator
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Single public contact address: site enquiries, support, and the payment
# gateway account all use this one address. Optional — defaults to
# poorprice@yahoo.com in lib/site-config.ts.
NEXT_PUBLIC_SITE_EMAIL=poorprice@yahoo.com
# Public origin, used for absolute URLs in metadata and outbound email.
NEXT_PUBLIC_SITE_URL=https://poorprice.com

# ── Payments ────────────────────────────────────────────────────────────────
# Both gateways are optional. Leave them blank and checkout runs in DEMO MODE:
# the whole flow works (order, confirmation, admin record) with a simulated
# payment, and the UI says so plainly. Add either set of keys to go live.

# Stripe — server-side secret only. Create one at
# https://dashboard.stripe.com/apikeys. Use sk_test_… to trial it; the app
# automatically labels test mode in the checkout UI.
STRIPE_SECRET_KEY=

# PayPal — REST app credentials from https://developer.paypal.com/dashboard.
# PAYPAL_ENV is `sandbox` (default) or `live`.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Force the demo provider on/off. `auto` (default) shows it only when no real
# gateway is usable, so a live site can never sell a fake order.
PAYMENTS_DEMO=auto

# Note: a configured gateway is VERIFIED before it is offered. The server makes
# one cheap authenticated call (Stripe /v1/balance, PayPal OAuth) and hides the
# provider if the credentials are rejected — so a typo'd or revoked key degrades
# to demo mode instead of appearing in checkout and failing every order. A
# rejection is logged once as `[payments] <provider> credentials rejected`.
# Results are cached: 10 minutes on success, 60 seconds on failure.

# Only needed when a proxy rewrites the Host header: the absolute origin the
# gateways should send customers back to. Otherwise the request's own origin is
# used, which is what makes local checkout work with no configuration.
PAYMENT_RETURN_ORIGIN=
